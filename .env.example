# =============================================================================
# SENTRY — environment configuration
# Copy this file to `.env` and fill in values for your environment.
# Never commit real credentials; `.env` is git-ignored.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development

# --- Database (required) -----------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentry

# --- CORS --------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# SENTRY FIELD local gateway. The frontend command center talks to this URL.
NEXT_PUBLIC_FIELD_API_URL=http://127.0.0.1:8001
# DroidCam / rover camera source used by SENTRY FIELD on the operator machine.
NEXT_PUBLIC_SENTRY_CAMERA_URL=http://127.0.0.1:4747/video

# --- SENTRY FIELD gateway ----------------------------------------------------
SENTRY_FIELD_API_HOST=127.0.0.1
SENTRY_FIELD_API_PORT=8001
SENTRY_CAMERA_URL=http://127.0.0.1:4747/video
SENTRY_CONFIDENCE=0.65
SENTRY_POTHOLE_EVERY_N_FRAMES=3

# --- LLM narration layer (all optional) --------------------------------------
# SENTRY's investigation engine is fully deterministic. A configured LLM is used
# ONLY to phrase conclusions already proven from the evidence (guarded by a
# deterministic grounding check). Leave every key unset to run fully offline.
LLM_PROVIDER_ORDER=anthropic,openrouter,openai,gemini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

ANTHROPIC_MODEL=claude-opus-4-8
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_MODEL=gemini-2.5-flash
