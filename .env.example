# =============================================================================
# SENTRY — environment configuration
# Copy this file to `.env` and fill in values for your environment.
# Never commit real credentials; `.env` is git-ignored.
# =============================================================================

# --- Application -------------------------------------------------------------
# Environment name: development | staging | production
APP_ENV=development

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection string used by the backend (SQLAlchemy + psycopg).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentry

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the backend API.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ----------------------------------------------------------------
# Base URL the Next.js frontend uses to reach the backend API.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# --- LLM narration layer (all optional) --------------------------------------
# SENTRY's investigation engine is fully deterministic. A configured LLM is used
# ONLY to phrase conclusions already proven from the evidence (guarded by a
# deterministic grounding check). Leave every key unset to run fully offline —
# the platform is complete without any of these.
#
# Providers are tried in this order; the first configured one that answers wins.
LLM_PROVIDER_ORDER=anthropic,openrouter,openai,gemini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# 1) Anthropic (official SDK)
#ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Optional Anthropic-compatible endpoint (proxy/gateway); unset = official API.
#ANTHROPIC_BASE_URL=

# 2) OpenRouter (OpenAI-compatible)
#OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3) OpenAI (OpenAI-compatible)
#OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 4) Google Gemini (Generative Language REST)
#GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
